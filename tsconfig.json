{
  "compilerOptions": {
    /* Configurações de Módulo e Saída */
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node", 
    "outDir": "./dist",
    "rootDir": "./",

    /* Diagnósticos e Mapas */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Rigor e Compatibilidade */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false, 
    "moduleDetection": "auto",
    
    /* Configurações de Ambiente */
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "tests/**/*" 
  ],
  "exclude": [
    "node_modules", 
    "build",
    "dist"
  ]
}